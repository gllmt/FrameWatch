{
  "name": "framewatch",
  "description": "Real-time video playback diagnostics browser extension",
  "private": true,
  "version": "0.1.0",
  "author": "Pierre Guillemot",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "biome lint .",
    "lints": "pnpm check && pnpm lint && tsc --noEmit",
    "format": "biome format --write .",
    "check": "biome check .",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
